# Choose the default provider: openrouter or openai.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Only needed if a purpose uses the OpenAI provider.
OPENAI_API_KEY=

# Production persistence. On Railway, attach a Volume at /data and retain this
# value. Local development defaults to .data when DATA_DIR is unset.
# DATA_DIR=/data

# Required in production. Issue one distinct five-digit numeric code per
# person. They choose their username and email on first use of that code.
# Keep this server-side; never use the NEXT_PUBLIC_ prefix.
# ACCESS_CODES=["12345","67890"]

# Use a long, random value to authorize an external catalogue refresh request.
CATALOG_SYNC_TOKEN=

# Optional per-purpose overrides: openrouter or openai.
# TRANSCRIBE_PROVIDER=openrouter
# SUMMARY_PROVIDER=openrouter
# DEEP_PROVIDER=openrouter
# CHAT_PROVIDER=openrouter

# Model IDs must belong to the provider selected for that purpose.
# Transcription must support verbose_json segment timestamps.
TRANSCRIBE_MODEL=openai/whisper-1
SUMMARY_MODEL=openai/gpt-4o-mini
DEEP_MODEL=openai/gpt-4o-mini
CHAT_MODEL=openai/gpt-4o-mini
